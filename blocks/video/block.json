{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "name": "zhdanov/video",
 "apiVersion": 3,
 "category": "zhdanov",
 "textdomain": "zhdanov-core",
 "editorScript": "zhdanov-core-editor",
 "style": "zhdanov-core-front",
